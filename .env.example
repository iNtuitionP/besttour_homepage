# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Solapi (SMS/LMS — 알림톡은 아직 보내지 않는다: 카카오 채널 인증·템플릿 심사(P4-0)가 사장님 대기)
# 아래 3키는 app/api/cron/notify/route.ts selectSender() 만 읽는다(P4-2). 셋이 전부 차 있어야 제공자 어댑터가 선택되고,
# 하나라도 비면 unconfigured 로 떨어져 발송기가 claim 조차 하지 않는다(claim 은 attempts 를 태운다).
# 우선순위: NOTIFY_SENDER=memory 를 켜 두면 이 3키가 차 있어도 memory 가 이긴다(운영 제외) — 명시적 지시가
# 우연히 남아 있는 설정보다 강하다. 그래서 로컬 실증 중에 실키가 남아 있어도 실제 번호로 문자가 나가지 않는다.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# 발신번호. 통신서비스 이용증명원으로 Solapi 에 사전등록한 번호만 쓸 수 있다(플랜 P0-7).
# 비워 두면 발송을 건너뛴다 — 등록되지 않은 번호로 문자가 나가는 것보다 안 나가는 편이 낫다.
# 형식만 검사한다(국내 휴대전화·지역번호·15xx/16xx/18xx 대표번호). 사전등록 여부는 제공자 응답으로만 알 수 있다.
SMS_SENDER=
# 사장님이 접수 알림을 받을 번호. 확인시트 C1 = "아직 번호를 만들지 않았다" 라 아직 미정이다.
# 비워 두면 사장님 통지를 건너뛰고 폴백 메일로만 알린다(플랜 §7). 여기에 임의의 번호를 넣지 마라.
OWNER_PHONE=

# 트랜잭션 메일 — Resend (P4-5). 아래 2키는 app/api/cron/notify/route.ts selectSender() 만 읽는다.
# 둘 다 차 있어야 메일 어댑터가 켜지고, 하나라도 비면 **메일 채널만** 꺼진다(문자는 문자 키만 보고 따로 켜진다).
# 꺼져 있는 동안 channel='email' 행은 claim 되지 않고 큐에 pending 으로 남는다 — attempts 가 보존되므로
# 키를 넣는 날 그대로 나간다(0014 채널 필터). 예전에는 문자 어댑터가 그 행을 집어가 5회 만에 죽였다.
# 🔴 **운영 전용 키다. 프리뷰·로컬에는 넣지 말 것**(또는 운영과 **다른 Resend 팀**의 키) — P4-6.
#   메일 요청에는 멱등성 키 `notify/<문안키>/<예약 uuid>/<행 id>` 가 붙는다. 운영 DB 를 프리뷰로 **복제**하면
#   예약 uuid 와 행 id 가 그대로 남아 키가 운영과 같아지고, 본문까지 같으면 Resend 가 **캐시된 성공**을 돌려줘
#   **진짜 발송이 억제**될 수 있다(외부 모델 검증이 짚은 유일한 위험 방향). 키가 비면 메일 채널이 꺼져 claim 조차 하지 않는다.
#   Vercel 에서는 이 변수를 **Production 스코프에만** 둔다.
RESEND_API_KEY=
# 발신 주소. 발신 도메인은 **send.bestour.co.kr 로 분리한다**(플랜 P4-5):
#   · SPF 는 도메인당 1건만 유효하다. 루트 도메인의 SPF 는 사람용 메일함(현재 카페24 MX) 전용으로 남겨 두고,
#     발송 전용 include 를 루트에 병합하면 DNS lookup 10회 제한에 걸린다.
#   · DKIM·return-path 도 서브도메인에 붙이므로 사람용 메일 설정과 서로 건드리지 않는다.
#   · 주의(CLAUDE.md §1-A): *.bestour.co.kr 와일드카드 CNAME 이 있어 서브도메인의 TXT/MX 가 조용히 실패할 수 있다 —
#     _dmarc·DKIM·인증 레코드는 **명시적 레코드로 덮어써야** 한다.
#   · bestour2013@naver.com 은 **수신 전용**이고 From 으로 절대 쓰지 않는다(네이버 외부 발신 금지 정책).
# 도메인 인증 전에는 제공자가 403/422 로 거절한다 — 그 코드가 last_error 에 그대로 남는다.
MAIL_FROM=
# 사장님이 알림 메일을 받을 주소. 쓰이는 데가 둘이다:
#   ① OWNER_PHONE 이 없을 때의 접수 알림 폴백 수신처(lib/notify/outbox.ts planNotifications)
#   ② **발송이 끝내 실패했을 때의 통지**(P4-4) — 통지가 5회를 다 태우고 죽으면 그 사실만 알리는 메일이 큐에 들어간다.
#      문안에 고객 이름·전화는 싣지 않는다(접수번호·어떤 통지인지·발송 내역 링크뿐).
# 이 값은 **수신처로만** 쓴다. 발신은 언제나 MAIL_FROM 이다 — bestour2013@naver.com 은 네이버가 외부 발신을 금지하므로
# 수신 전용이고 From 으로 절대 쓰지 않는다.
# 지어내지 마라. 비어 있으면 ①은 아예 만들어지지 않고(접수 로그 warning), ②는 넣지 않은 채 크론 보고서의
# failureNotices.no_owner_email 로 드러난다 — 조용히 넘어가지 않는다.
OWNER_EMAIL=

# Channel links
NEXT_PUBLIC_KAKAO_CHANNEL_URL=
NEXT_PUBLIC_NAVER_TALK_URL=
# 옛 사이트 메뉴 "네이버 블로그" 주소. 비어 있으면 메뉴에서 항목 자체를 숨긴다 (lib/legacy-menu-map.ts)
NEXT_PUBLIC_NAVER_BLOG_URL=

# Vercel Cron (개인정보 파기 배치 /api/cron/purge · 통지 발송기 /api/cron/notify 인증 — Vercel 이 Authorization: Bearer 로 붙여 보낸다)
CRON_SECRET=
# 통지 발송기(P4-1)의 sender 선택 — app/api/cron/notify/route.ts 만 읽는다. 비워 두면 미구성: 발송기는 claim 조차 하지 않는다
# (claim 은 attempts 를 소모한다 — 키 없는 기간에 태우면 키가 온 뒤 보낼 수 없다). "memory" = 로컬 실증용 인메모리 sender(실제 발송
# 없이 sent 처리). **이 값이 SOLAPI 키보다 우선한다** — 실키가 남아 있어도 memory 를 켜면 실제 발송이 없다.
# 운영(VERCEL_ENV=production)에서는 이 지시만 무시되고(warn 1줄) SOLAPI 키가 있으면 제공자로, 없으면 unconfigured 로 간다.
NOTIFY_SENDER=

# 공개 뮤테이션 방어 (lib/guard — P3-1). 위 TURNSTILE_SECRET_KEY·UPSTASH_* 를 함께 쓴다.
# 타임트랩 토큰의 HMAC 키이자 rate limit 키 해시(sha256(GUARD_SECRET + ip) 앞 16자)의 salt. 32자 이상. 예: openssl rand -hex 32
# 바뀌면 발급된 폼 토큰이 전부 무효가 되고 rate limit 카운트가 리셋된다(개인정보 없음 — 손실 없음).
GUARD_SECRET=
# Turnstile siteverify 응답의 hostname 허용 목록(쉼표 구분, 포트 없음). 개발: localhost · 운영/프리뷰: 실제 접속 호스트를 전부 적는다.
# Cloudflare 대시보드의 위젯 도메인 목록과 별개로 서버가 한 번 더 확인한다. 비어 있으면 접수가 열리지 않는다(fail-closed).
GUARD_ALLOWED_HOSTS=

# 관리자 로그인 허용 주소 목록 (P5-1 — lib/auth/adminLogin.ts 만 읽는다). 쉼표 구분, 대소문자·공백 무시.
# 여기 없는 주소로는 매직링크를 보내지 않는다(응답은 보낸 것과 구분되지 않는다). Supabase Auth 에 그 사용자가
# **미리 만들어져 있어야** 한다 — 액션이 shouldCreateUser:false 로 요청하므로 계정이 새로 생기는 경로는 없다.
# **비워 두면 관리자 로그인이 닫힌다**(fail-closed) — 설정 누락이 "아무나 링크를 받을 수 있음"이 되지 않게.
ADMIN_EMAILS=

# robots.txt · sitemap.xml 의 절대 URL 원점 (lib/site-url.ts — P7-2). 끝 슬래시는 자동으로 뗀다.
# P5-1 부터 매직링크의 emailRedirectTo(<원점>/admin/auth/callback)도 이 값을 쓴다 — 환경마다 반드시 채우고,
# 그 URL 을 Supabase 대시보드의 Redirect URLs 허용 목록에도 넣어야 링크가 동작한다.
# 비워 두면 https://bestour.co.kr 로 폴백한다. 프리뷰 배포는 그 배포의 URL 을 넣는다(프리뷰는 어차피 전면 noindex).
NEXT_PUBLIC_SITE_URL=

# 검색엔진 소유확인 메타 (lib/site-url.ts siteVerification() — P7-2b). app/[locale]/layout.tsx 가 전 공개 페이지에 낸다.
# 값은 **사장님이 각 콘솔에서 발급받는다** — 지어내지 말 것. 비워 두면 태그 자체를 내지 않는다
# (빈 content="" 는 콘솔이 "확인 실패" 로 읽는다 — 태그가 없느니만 못하다). 비어 있는 것이 정상 상태다.
# 네이버 서치어드바이저 > 사이트 등록 > HTML 태그의 content 값(<meta name="naver-site-verification" content="여기">)
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
# 구글 서치콘솔 > URL 접두어 > HTML 태그의 content 값(<meta name="google-site-verification" content="여기">)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
