# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Solapi (SMS)
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# 발신번호. 통신서비스 이용증명원으로 Solapi 에 사전등록한 번호만 쓸 수 있다(플랜 P0-7).
# 비워 두면 발송을 건너뛴다 — 등록되지 않은 번호로 문자가 나가는 것보다 안 나가는 편이 낫다.
SMS_SENDER=
# 사장님이 접수 알림을 받을 번호. 확인시트 C1 = "아직 번호를 만들지 않았다" 라 아직 미정이다.
# 비워 두면 사장님 통지를 건너뛰고 폴백 메일로만 알린다(플랜 §7). 여기에 임의의 번호를 넣지 마라.
OWNER_PHONE=

# Channel links
NEXT_PUBLIC_KAKAO_CHANNEL_URL=
NEXT_PUBLIC_NAVER_TALK_URL=
# 옛 사이트 메뉴 "네이버 블로그" 주소. 비어 있으면 메뉴에서 항목 자체를 숨긴다 (lib/legacy-menu-map.ts)
NEXT_PUBLIC_NAVER_BLOG_URL=

# Vercel Cron (개인정보 파기 배치 /api/cron/purge · 통지 발송기 /api/cron/notify 인증 — Vercel 이 Authorization: Bearer 로 붙여 보낸다)
CRON_SECRET=
# 통지 발송기(P4-1)의 sender 선택 — app/api/cron/notify/route.ts 만 읽는다. 비워 두면 미구성: 발송기는 claim 조차 하지 않는다
# (claim 은 attempts 를 소모한다 — 키 없는 기간에 태우면 키가 온 뒤 보낼 수 없다). "memory" = 로컬 실증용 인메모리 sender(실제 발송
# 없이 sent 처리) — VERCEL_ENV=production 에서는 무시된다. 실제 제공자 분기(SOLAPI_API_KEY)는 P4-2 가 route.ts 에 추가한다.
NOTIFY_SENDER=

# 공개 뮤테이션 방어 (lib/guard — P3-1). 위 TURNSTILE_SECRET_KEY·UPSTASH_* 를 함께 쓴다.
# 타임트랩 토큰의 HMAC 키이자 rate limit 키 해시(sha256(GUARD_SECRET + ip) 앞 16자)의 salt. 32자 이상. 예: openssl rand -hex 32
# 바뀌면 발급된 폼 토큰이 전부 무효가 되고 rate limit 카운트가 리셋된다(개인정보 없음 — 손실 없음).
GUARD_SECRET=
# Turnstile siteverify 응답의 hostname 허용 목록(쉼표 구분, 포트 없음). 개발: localhost · 운영/프리뷰: 실제 접속 호스트를 전부 적는다.
# Cloudflare 대시보드의 위젯 도메인 목록과 별개로 서버가 한 번 더 확인한다. 비어 있으면 접수가 열리지 않는다(fail-closed).
GUARD_ALLOWED_HOSTS=

# 관리자 로그인 허용 주소 목록 (P5-1 — lib/auth/adminLogin.ts 만 읽는다). 쉼표 구분, 대소문자·공백 무시.
# 여기 없는 주소로는 매직링크를 보내지 않는다(응답은 보낸 것과 구분되지 않는다). Supabase Auth 에 그 사용자가
# **미리 만들어져 있어야** 한다 — 액션이 shouldCreateUser:false 로 요청하므로 계정이 새로 생기는 경로는 없다.
# **비워 두면 관리자 로그인이 닫힌다**(fail-closed) — 설정 누락이 "아무나 링크를 받을 수 있음"이 되지 않게.
ADMIN_EMAILS=

# robots.txt · sitemap.xml 의 절대 URL 원점 (lib/site-url.ts — P7-2). 끝 슬래시는 자동으로 뗀다.
# P5-1 부터 매직링크의 emailRedirectTo(<원점>/admin/auth/callback)도 이 값을 쓴다 — 환경마다 반드시 채우고,
# 그 URL 을 Supabase 대시보드의 Redirect URLs 허용 목록에도 넣어야 링크가 동작한다.
# 비워 두면 https://bestour.co.kr 로 폴백한다. 프리뷰 배포는 그 배포의 URL 을 넣는다(프리뷰는 어차피 전면 noindex).
NEXT_PUBLIC_SITE_URL=

# 검색엔진 소유확인 메타 (lib/site-url.ts siteVerification() — P7-2b). app/[locale]/layout.tsx 가 전 공개 페이지에 낸다.
# 값은 **사장님이 각 콘솔에서 발급받는다** — 지어내지 말 것. 비워 두면 태그 자체를 내지 않는다
# (빈 content="" 는 콘솔이 "확인 실패" 로 읽는다 — 태그가 없느니만 못하다). 비어 있는 것이 정상 상태다.
# 네이버 서치어드바이저 > 사이트 등록 > HTML 태그의 content 값(<meta name="naver-site-verification" content="여기">)
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
# 구글 서치콘솔 > URL 접두어 > HTML 태그의 content 값(<meta name="google-site-verification" content="여기">)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
