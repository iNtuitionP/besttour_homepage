# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Solapi (SMS)
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
# 발신번호. 통신서비스 이용증명원으로 Solapi 에 사전등록한 번호만 쓸 수 있다(플랜 P0-7).
# 비워 두면 발송을 건너뛴다 — 등록되지 않은 번호로 문자가 나가는 것보다 안 나가는 편이 낫다.
SMS_SENDER=
# 사장님이 접수 알림을 받을 번호. 확인시트 C1 = "아직 번호를 만들지 않았다" 라 아직 미정이다.
# 비워 두면 사장님 통지를 건너뛰고 폴백 메일로만 알린다(플랜 §7). 여기에 임의의 번호를 넣지 마라.
OWNER_PHONE=

# Channel links
NEXT_PUBLIC_KAKAO_CHANNEL_URL=
NEXT_PUBLIC_NAVER_TALK_URL=
# 옛 사이트 메뉴 "네이버 블로그" 주소. 비어 있으면 메뉴에서 항목 자체를 숨긴다 (lib/legacy-menu-map.ts)
NEXT_PUBLIC_NAVER_BLOG_URL=

# Vercel Cron (개인정보 파기 배치 /api/cron/purge 인증 — Vercel 이 Authorization: Bearer 로 붙여 보낸다)
CRON_SECRET=
