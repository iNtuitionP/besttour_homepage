# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# project-internal (not part of the app build)
.superpowers/
.gstack/

# 훅 테스트 부산물
/tmp-hook-probe*

# Supabase CLI 로컬 상태
supabase/.temp/

# 클라이언트 기밀 — 이 저장소는 public 이므로 절대 커밋하지 않는다
# (사업자등록증 스캔, 사장님이 작성한 확인 시트 답변, 관리자 계정 정보 등)
docs/private/
*.stackdump
